{
  "name": "ariadne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "흔적(trace)에서 원천(source)까지 실을 잇는 서양 교양 학습·조회·퀴즈 웹앱",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "build:content": "tsx scripts/build.ts",
    "audit": "tsx scripts/validate.ts --report",
    "emblems": "node scripts/emblem-sheet.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run validate && npm run build:content",
    "dev": "npm run build:content && next dev",
    "build": "npm run build:content && next build",
    "start": "next start",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "npm run check && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
